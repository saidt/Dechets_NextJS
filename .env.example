# Settings read from .env (copy to .env and adjust). Defaults in brackets.
# This file holds no secrets: NEXTAUTH_SECRET, DATABASE_URL etc. go only in the real .env.

# --- Server: read when the server starts (restart to apply) ---
# Session length after login, fixed whatever the activity, in hours [24]
SESSION_MAX_AGE_HOURS=24
# Failed logins (within LOGIN_LOCK_MINUTES) that lock a user id [5]
LOGIN_MAX_FAILURES=5
# Lock duration in minutes, counted from the oldest of those failures [15]
LOGIN_LOCK_MINUTES=15

# --- Browser: written into the app when it is built (rebuild to apply) ---
# Delay after typing in a column filter before the list reloads, in ms [500]
NEXT_PUBLIC_FILTER_DEBOUNCE_MS=500
# How often an open page checks that its session is still valid, in seconds [60]
NEXT_PUBLIC_SESSION_CHECK_INTERVAL_SECONDS=60
