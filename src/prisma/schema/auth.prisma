model User {
  id           String     @id
  name         String?
  email        String?    @unique
  psw_hash     String?    @db.NVarChar(255)
  last_connect DateTime?  @db.DateTime
  // 'O': super user, passes every role check (USER_ROLE is not read). 'N' otherwise.
  super_user   String     @default("N") @map("SUPER_USER") @db.Char(1)

  sessions           Session[]
  user_roles         User_Role[]
  user_table_params  User_Table_Param[]
  user_table_filters User_Table_Filter[]

  @@map("USER_")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique                  @map("SESSION_TOKEN")
  userId       String                            @map("USER_ID")
  expires      DateTime @db.DateTime
  userAgent    String?  @map("USER_AGENT") @db.NVarChar(500)
  ipAddress    String?  @map("IP_ADDRESS") @db.NVarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("SESSION")
}